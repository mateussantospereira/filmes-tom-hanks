# =============================================================================
# Variaveis de ambiente dos DOIS servicos (docker-compose.yml le este arquivo)
# Copie para .env e preencha: cp .env.example .env
# =============================================================================

# --- Catalogo (container `app`, o unico com porta publicada) -------------------
TMDB_API_KEY=
AUTH_SERVICE_URL=http://auth-service:3000

# --- auth-service (container `auth-service`, SEM porta publicada) --------------
# URL publica do catalogo. E aqui que o link de redefinicao de senha aponta:
# o navegador so conhece o endereco do catalogo, nunca o do auth-service.
APP_PUBLIC_URL=https://SEU-SUBDOMINIO/

# O segredo de assinatura do JWT fica SO no auth-service. O catalogo nao tem
# JWT_SECRET de proposito: sem o segredo ele nao valida nem forja token.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Prazo de validade do link de redefinicao (requisito da atividade: 30 minutos)
RESET_TOKEN_TTL_MINUTES=30

# --- E-mail: DESENVOLVIMENTO (Mailtrap) ----------------------------------------
# Crie uma conta em https://mailtrap.io e copie as credenciais SMTP daqui.
# O e-mail nao sai de fato para o mundo: ele chega na inbox da sua conta
# Mailtrap, exatamente como seria entregue.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Catalogo de Filmes

# --- E-mail: PRODUCAO (Brevo) -------------------------------------------------
# Troque as quatro linhas acima por estas (envio transacional de verdade,
# com camada gratuita). O codigo do servico e o mesmo: muda so o destino.
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Catalogo de Filmes

# --- MariaDB (mesmo banco para os dois servicos) ------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
