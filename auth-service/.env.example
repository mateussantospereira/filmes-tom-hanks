# Porta do servico DENTRO do container. Nao e publicada no host.
PORT=3000
NODE_ENV=development

# URL publica do CATALOGO (o unico container com porta publicada).
# O link de redefinicao aponta para ca, e o catalogo repassa a validacao
# para o auth-service por dentro da rede do Docker.
APP_PUBLIC_URL=http://localhost:8222

# MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Requisito 4: o link de redefinicao expira em 30 minutos
RESET_TOKEN_TTL_MINUTES=30

# Requisito 5 — e-mail. Desenvolvimento: Mailtrap.
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Catalogo de Filmes

# Producao: Brevo (envio transacional de verdade)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
