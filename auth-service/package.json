{
  "name": "auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Microsservico de autenticacao — login, cadastro, papeis (role) e recuperacao de senha",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "db:migrate": "bun run src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/nodemailer": "^6.4.14",
    "drizzle-kit": "^0.31.10"
  }
}
